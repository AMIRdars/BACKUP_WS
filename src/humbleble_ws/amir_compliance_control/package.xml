<?xml version="1.0"?>
<package format="3">
  <name>amir_compliance_control</name><version>0.1.0</version>
  <description>Local AMIR sensor processing, bounded arm admittance, simulation safety gates and leader-only goals, independent of evaluation packages.</description>
  <maintainer email="dars5070@todo.todo">dars5070</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend><exec_depend>tf2_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend><exec_depend>action_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend><exec_depend>trajectory_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
