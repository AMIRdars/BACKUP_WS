<?xml version="1.0"?>
<robot name="mecanum3"
       xmlns:xacro="http://www.ros.org/wiki/xacro"
       xmlns:ignition="http://ignitionrobotics.org">

  <!-- マルチロボット用 namespace (空なら従来どおり無 prefix) -->
  <xacro:arg name="namespace" default=""/>
  <xacro:property name="robot_ns" value="$(arg namespace)"/>
  <!-- prefix 文字列: namespace 空→"" , "amir1"→"amir1/" -->
  <xacro:property name="ns_prefix" value="${robot_ns + '/' if robot_ns else ''}"/>

  <!-- Ignition Gazebo gz_ros2_control plugin
       <ros><namespace> で controller_manager / joint_states を
       /<ns>/... 配下へ移す (マルチロボットでの衝突回避) -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find mecanumrover_description)/params/controllers.yaml</parameters>
      <ros>
        <namespace>${robot_ns}</namespace>
      </ros>
    </plugin>
  </gazebo>

  <!-- Ground-truth odometry (simulation only).
       Publishes /odom and the odom->base_footprint transform (on /odom/tf) from the
       model's true pose instead of wheel encoders. The 4 fixed cylinder wheels scrub
       laterally during in-place rotation, so wheel-encoder odometry (via mecanum
       kinematics) slips and corrupted the SLAM map. True-pose odom keeps the map
       consistent — the same mechanism the TB3 reference sim relies on.
       Bridged to ROS2 in amir_gazebo/launch/gazebo_bringup.launch.py (odom_bridge). -->
  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_publish_frequency>50</odom_publish_frequency>
      <!-- topic 名は prefix (sim バス衝突回避)、frame 名は無 prefix
           (ロボットごとの /tf に載せるので frame は標準名で衝突しない) -->
      <odom_topic>/${ns_prefix}odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <tf_topic>/${ns_prefix}odom/tf</tf_topic>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/Silver</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <selfCollide>true</selfCollide>
    <gravity>true</gravity>
  </gazebo>

  <gazebo reference="front_left_wheel_1">
    <material>Gazebo/Silver</material>
    <mu1>1.0</mu1>
    <mu2>0.0</mu2>
    <fdir1 ignition:expressed_in="base_footprint">1 -1 0</fdir1>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="front_right_wheel_1">
    <material>Gazebo/Silver</material>
    <mu1>1.0</mu1>
    <mu2>0.0</mu2>
    <fdir1 ignition:expressed_in="base_footprint">1 1 0</fdir1>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="back_left_wheel_1">
    <material>Gazebo/Silver</material>
    <mu1>1.0</mu1>
    <mu2>0.0</mu2>
    <fdir1 ignition:expressed_in="base_footprint">1 1 0</fdir1>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="back_right_wheel_1">
    <material>Gazebo/Silver</material>
    <mu1>1.0</mu1>
    <mu2>0.0</mu2>
    <fdir1 ignition:expressed_in="base_footprint">1 -1 0</fdir1>
    <selfCollide>false</selfCollide>
  </gazebo>

</robot>
