 <BehaviorTree ID="MainTree">
    <SequenceStar name="root">
      <!-- <SetMecaGoal x="1.2" y="0.7" posi_x="{posi_x}" posi_y="{posi_y}"/> -->
      <!-- <ReceiveMecaGoal posi_x="{posi_x}" posi_y="{posi_y}"/> -->
      <!-- <MoveMeca action_name="amir/move_meca" posi_x="{posi_x}" posi_y="{posi_y}" server_timeout="{server_timeout}"/> -->

      <CalculatePlacePosi name="calc_pick_posi" x="0.30" y="0.3" z="0.10" pose_obj="{pose_obj}"/>
      <!-- <CalculateObj pose_obj="{pose_obj}"/> -->
      <PickAmir action_name="pick" pose_obj="{pose_obj}" server_timeout="{server_timeout}"/>
     
      <SetMecaGoal x="-0.3" y="0.01" posi_x="{posi_x}" posi_y="{posi_y}"/>
      <!-- <ReceiveMecaGoal posi_x="{posi_x}" posi_y="{posi_y}"/> -->
      <MoveMeca action_name="amir/move_meca" posi_x="{posi_x}" posi_y="{posi_y}" server_timeout="{server_timeout}"/>

      <CalculatePlacePosi name="calc_place_posi" x="0.30" y="-0.3" z="0.15" pose_obj="{pose_obj}"/>
      <PlaceAmir action_name="place" pose_obj="{pose_obj}" server_timeout="{server_timeout}"/>
      
      <TaskClear/>
    </SequenceStar>
  </BehaviorTree>

</root>
