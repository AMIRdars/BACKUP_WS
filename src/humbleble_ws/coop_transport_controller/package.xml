<?xml version="1.0"?>
<package format="3">
  <name>coop_transport_controller</name>
  <version>0.1.0</version>
  <description>Action adapter between Behavior Trees and cooperative transport control.</description>
  <maintainer email="dars5070@todo.todo">dars5070</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>coop_transport_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
