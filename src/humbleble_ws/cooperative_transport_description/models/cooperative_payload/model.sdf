<?xml version="1.0"?>
<sdf version="1.8">
  <model name="cooperative_payload">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="payload_link">
      <inertial>
        <mass>8.0</mass>
        <!-- Solid box, size 1.20 x 0.03 x 0.08 m. The 30 mm grasp
             thickness fits between the existing AMIR fingers. -->
        <inertia>
          <ixx>0.004867</ixx>
          <iyy>0.964267</iyy>
          <izz>0.960600</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name="payload_visual">
        <geometry><box><size>1.20 0.03 0.08</size></box></geometry>
        <material>
          <ambient>0.55 0.35 0.18 1</ambient>
          <diffuse>0.65 0.42 0.20 1</diffuse>
        </material>
      </visual>
      <collision name="payload_collision">
        <!-- Keep collision geometry at both ends so closing the two physical
             grippers makes contact before the transport joint is attached. -->
        <geometry><box><size>1.20 0.03 0.08</size></box></geometry>
        <surface>
          <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.05</max_vel><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
    </link>

    <!--
      URDF fixed-joint lumping removes tcp_link from the Gazebo entity tree.
      The physical joint therefore uses gripper_base_1. These frames include
      the 0.0795 m TCP offset so the payload ends meet the finger centers. For
      the current Q_HOME this is paired with base positions x=+-1.074987 m.
    -->
    <link name="grasp_r1_link">
      <pose>-0.6795 0 0 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
    </link>
    <joint name="payload_to_grasp_r1" type="fixed">
      <parent>payload_link</parent><child>grasp_r1_link</child>
    </joint>

    <link name="grasp_r2_link">
      <pose>0.6795 0 0 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
    </link>
    <joint name="payload_to_grasp_r2" type="fixed">
      <parent>payload_link</parent><child>grasp_r2_link</child>
    </joint>

    <!-- Fortress / ign-gazebo6 plugin names intentionally differ from Harmonic. -->
    <plugin filename="ignition-gazebo-detachable-joint-system"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>grasp_r1_link</parent_link>
      <child_model>amir1</child_model>
      <child_link>gripper_base_1</child_link>
      <attach_topic>/amir1/grasp/attach</attach_topic>
      <detach_topic>/amir1/grasp/detach</detach_topic>
      <output_topic>/amir1/grasp/state</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>

    <plugin filename="ignition-gazebo-detachable-joint-system"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>grasp_r2_link</parent_link>
      <child_model>amir2</child_model>
      <child_link>gripper_base_1</child_link>
      <attach_topic>/amir2/grasp/attach</attach_topic>
      <detach_topic>/amir2/grasp/detach</detach_topic>
      <output_topic>/amir2/grasp/state</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>
  </model>
</sdf>
